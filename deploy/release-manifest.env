# Auditable release inputs for deploy/install.sh.
#
# The installer embeds these values so it remains a single-file installer.
# Keep the two copies identical when cutting a release. A release is not
# installable until the controller and project-built sing-box SHA256 values are
# replaced with the hashes produced by the release workflow.

V3NODE_VERSION=0.1.0
V3NODE_AMD64_ASSET=v3node-linux-amd64
V3NODE_ARM64_ASSET=v3node-linux-arm64
V3NODE_AMD64_SHA256=UNPUBLISHED_REPLACE_WITH_64_HEX_SHA256
V3NODE_ARM64_SHA256=UNPUBLISHED_REPLACE_WITH_64_HEX_SHA256

# Project sing-box builds. The generic upstream v1.13.18 Linux assets omit
# with_v2ray_api; the bounded project patches expose authenticated users and
# enforce configured per-user rates. Build with engine-patches/sing-box/build.sh,
# publish separate GPLv3 engine/source assets, and replace both hashes.
SING_BOX_VERSION=1.13.18
SING_BOX_COMMIT=45ca32dcb966f07f97fc888fe8586e359dbe8405
SING_BOX_SOURCE_SHA256=62693e51bbc42d937af923f888b8a9c197127e3ca25f3a6e01f863963b43f450
SING_BOX_PATCHSET=engine-patches/sing-box/0001-expose-authenticated-user.patch,engine-patches/sing-box/0002-bounded-user-rate-limit.patch
SING_BOX_BUILD_TAGS=with_quic,with_grpc,with_v2ray_api,with_clash_api,with_utls
SING_BOX_AMD64_ASSET=v3node-edge-1.13.18-p2-linux-amd64
SING_BOX_ARM64_ASSET=v3node-edge-1.13.18-p2-linux-arm64
SING_BOX_AMD64_SHA256=UNPUBLISHED_REPLACE_WITH_64_HEX_SHA256
SING_BOX_ARM64_SHA256=UNPUBLISHED_REPLACE_WITH_64_HEX_SHA256

# Stock Xray is used only for transports that sing-box cannot preserve (most
# notably XHTTP/SplitHTTP). These are the official, versioned upstream ZIPs.
XRAY_VERSION=26.3.27
XRAY_COMMIT=d2758a0
XRAY_RELEASE_BASE=https://github.com/XTLS/Xray-core/releases/download/v26.3.27
XRAY_AMD64_ASSET=Xray-linux-64.zip
XRAY_ARM64_ASSET=Xray-linux-arm64-v8a.zip
XRAY_AMD64_SHA256=23cd9af937744d97776ee35ecad4972cf4b2109d1e0fe6be9930467608f7c8ae
XRAY_ARM64_SHA256=4d30283ae614e3057f730f67cd088a42be6fdf91f8639d82cb69e48cde80413c
